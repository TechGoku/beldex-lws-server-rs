# Settings for deploy/docker-compose.yml. Copy to deploy/.env and edit.

# main, test or dev
LWS_NETWORK=main
# beldexd RPC, as seen from the containers. host.docker.internal is this machine.
# Mainnet RPC is 19091, testnet 29091, devnet 39091. Several: comma-separated.
LWS_DAEMON=http://host.docker.internal:19091
# Optional: beldexd's OxenMQ endpoint (beldexd --lmq-public), so new blocks are
# seen at once instead of at the next poll.
# LWS_NOTIFY=tcp://host.docker.internal:20202

# Public name for `--profile public` (Caddy gets the certificate for it).
# LWS_DOMAIN=lws.example.com

# auto, manual or disabled
LWS_ACCOUNT_CREATION=auto
# The database is not published outside the compose network; change it anyway.
POSTGRES_PASSWORD=change-me
